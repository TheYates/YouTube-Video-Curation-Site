# Signal web (Next.js) — copy to `.env.local` and fill in.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Admin allow-list — Google accounts permitted into /admin (comma-separated).
# Server-only (no NEXT_PUBLIC_ prefix): the edge middleware reads it.
# Empty = nobody can enter (fail closed).
ADMIN_EMAILS=you@gmail.com

# Canonical site URL — used for sitemap.xml, robots.txt, and OG/canonical tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local ingest relay (dev machine only). Unset in production — the admin UI
# falls back to cloud ingest when the relay is unreachable.
NEXT_PUBLIC_INGEST_RELAY_URL=http://127.0.0.1:8931

# Newsletter is disabled (no signup backend yet). Leave unset/false.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# Display ads. Keep unset/false until real ad tags exist — the placeholder
# boxes stay hidden so the site never looks unfinished or ad-first.
NEXT_PUBLIC_ADS_ENABLED=false
