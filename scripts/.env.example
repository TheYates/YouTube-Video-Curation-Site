[TEMPLATE]
# Local ingest script config. Copy to scripts/.env and fill in.
# NEVER commit the real file. Service-role key bypasses RLS — keep it secret.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
YOUTUBE_API_KEY=AIza...
GROQ_API_KEY=gsk_...

# Optional: shared token for the local relay (if set, requests must send
# header x-ingest-token: <token>).
# INGEST_TOKEN=
# INGEST_PORT=8931

# Deployed origin — used by IndexNow pings (and other tooling that needs an
# absolute URL). Must match where web/public/<KEY>.txt is served. Update on
# domain swap.
# SITE_URL=https://curateur-ashy.vercel.app

# Optional: rotate the IndexNow key. Must match web/public/<key>.txt.
# INDEXNOW_KEY=
