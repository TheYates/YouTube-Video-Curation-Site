# Signal — local env template. Copy to `.env.local` and fill in.
# `.env*` is gitignored (except this file).
#
# The app runs on built-in mock data until BOTH Supabase vars are set.
# Flip back to mock any time by unsetting them (or deleting .env.local).

# Frontend Supabase config — safe to expose in the browser (RLS protects writes).
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# ── Backend only — NEVER prefix with VITE_, NEVER put in the browser bundle ──
# YOUTUBE_API_KEY=...
# GROQ_API_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
